# 环境变量模板：复制为 .env 后填写。
# 读取优先级：.env.local > .env；启动期由 src/config/env.validation.ts 校验，
# 缺 JWT_SECRET / JWT_REFRESH_SECRET 或端口不是数字会直接启动失败。

# 应用（src/config/app.config.ts → app.*）
PORT=3000
API_PREFIX=api

# 数据库 MySQL（src/config/database.config.ts → database.*）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=concise_server
# true 时 TypeORM 自动同步表结构，仅开发可用
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT（src/config/jwt.config.ts → jwt.*）
# 必填，长度 >= 16；两个密钥必须不同，accessToken / refreshToken 各用一套
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# 滑块验证码（src/config/captcha.config.ts → captcha.*）
# CAPTCHA_ENABLED=true 时登录强制校验（先 POST /auth/captcha/verify 换 ticket，再带 captchaTicket 登录）
CAPTCHA_ENABLED=true

# Redis（src/config/redis.config.ts → redis.*）
# REDIS_ENABLED=true 时验证码/在线用户/令牌黑名单等共享状态走 Redis，支持多实例部署；false 时不建连接
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 留空表示无密码
REDIS_PASSWORD=
# 库号（默认 0）
REDIS_DB=0

# 反向代理信任范围（src/main.ts → resolveTrustProxy）
# 默认false：不信任任何 X-Forwarded-For，直连部署直接用 socket 真实 IP（防伪造审计 IP）。
# 部署在 Nginx 后面时必须显式打开，填受信网段，例如：
# TRUST_PROXY=loopback, 10.0.0.0/8
# 也可以填跳数（TRUST_PROXY=2 表示信任最近两跳）
TRUST_PROXY=

# Swagger 文档（src/main.ts）
# 不填时：NODE_ENV=production 关闭，其余开启
SWAGGER_ENABLED=

# 限流（src/common/guards/rate-limit.guard.ts）
# 关闭后所有接口不限流，仅建议本地压测时使用
RATE_LIMIT_ENABLED=true
# 单 IP 单接口默认阈值：RATE_LIMIT_LIMIT 次 / RATE_LIMIT_WINDOW 秒
RATE_LIMIT_LIMIT=120
RATE_LIMIT_WINDOW=60

# 登录失败锁定（src/modules/auth/services/auth.service.ts）
# 同账号连续密码错误 LOGIN_MAX_FAILS 次 → 锁定 LOGIN_LOCK_HOURS 小时（默认错 5 次锁一天）
# 登录成功自动清零计数；管理员可在用户管理里「解锁」提前解除
LOGIN_MAX_FAILS=5
LOGIN_LOCK_HOURS=24

# 旧版（无 /v1 前缀）路由开关
# 前端已全量切到 /v1，默认关闭；确有老客户端/脚本依赖时才置 true
LEGACY_ROUTES_ENABLED=false

# 文件管理（src/modules/tools/file）
# 物理文件目录：按 sha256 内容寻址存放，刻意不在 public/ 下（public 会静态托管，上传的 html 可同源执行）
# 不填默认 ./storage/files；上传临时文件默认 ./storage/tmp（同盘 rename 才不会退化成拷贝）
FILE_STORAGE_DIR=
FILE_TEMP_DIR=
# 单用户配额（MB），超出后上传直接 400
FILE_QUOTA_MB=2048
# 单文件上限（MB）
FILE_UPLOAD_MAX_MB=200
# 回收站保留天数：超期由每日清理任务彻底删除（连同物理文件）；0 或负数表示不自动清理
FILE_RECYCLE_DAYS=30
# 上传临时文件保留小时数：清理客户端中断留下的残留；0 或负数表示不清理
FILE_TMP_HOURS=24

# ── OIDC / SSO 单点登录（src/modules/auth/services/sso.service.ts）────────────
# 总开关：开启后登录页展示「单点登录」按钮，/api/v1/auth/sso/* 接口生效
OIDC_ENABLED=false
# IdP 根地址（如 https://keycloak.example.com/realms/master），会自动读 /.well-known/openid-configuration
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# 授权范围，默认标准三件套
OIDC_SCOPE=openid profile email
# 回调地址：留空按请求的协议/域名自动推导为 http://<host>/api/v1/auth/sso/callback（反代/HTTPS 环境建议显式配置）
OIDC_REDIRECT_URI=
# 登录成功后回跳的前端页面（一次性 code 通过 query 传入）
OIDC_FRONTEND_REDIRECT=http://localhost:5173/sso-callback
# 用 userinfo 的哪个字段映射本地登录账号
OIDC_USERNAME_CLAIM=preferred_username
# 本地查无此人时是否自动建档（密码随机，只能走 SSO 登录）
OIDC_AUTO_CREATE=true
# 自动建档时绑定的角色编码（逗号分隔），空 = 不绑角色
OIDC_DEFAULT_ROLES=viewer

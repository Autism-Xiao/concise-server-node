# 环境变量模板：复制为 .env 后填写。
# 读取优先级：.env.local > .env；启动期由 src/config/env.validation.ts 校验，
# 缺 JWT_SECRET / JWT_REFRESH_SECRET 或端口不是数字会直接启动失败。

# 应用（src/config/app.config.ts → app.*）
PORT=3000
API_PREFIX=api

# 数据库 MySQL（src/config/database.config.ts → database.*）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=concise_server
# true 时 TypeORM 自动同步表结构，仅开发可用
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT（src/config/jwt.config.ts → jwt.*）
# 必填，长度 >= 16；两个密钥必须不同，accessToken / refreshToken 各用一套
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# 滑块验证码（src/config/captcha.config.ts → captcha.*）
# CAPTCHA_ENABLED=true 时登录强制校验（先 POST /auth/captcha/verify 换 ticket，再带 captchaTicket 登录）
CAPTCHA_ENABLED=true

# Redis（src/config/redis.config.ts → redis.*）
# REDIS_ENABLED=true 时验证码/在线用户/令牌黑名单等共享状态走 Redis，支持多实例部署；false 时不建连接
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 留空表示无密码
REDIS_PASSWORD=
# 库号（默认 0）
REDIS_DB=0

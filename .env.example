# 应用
PORT=3000
API_PREFIX=api

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_DATABASE=concise_server
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# 验证码（生产环境 CAPTCHA_DEBUG 必须为 false）
CAPTCHA_ENABLED=true
CAPTCHA_DEBUG=false

# Redis（REDIS_ENABLED=true 时验证码等共享状态走 Redis，支持多实例部署；false 时降级进程内存）
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

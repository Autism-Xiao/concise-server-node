# docker compose 专用密钥模板：复制为 .env.docker 后填入真实值
#   cp .env.docker.example .env.docker   （.env.docker 已被 .dockerignore/.gitignore 排除）

# 应用端口映射
APP_PORT=3000

# 数据库（容器内 MySQL 的账号密码）
DB_USERNAME=concise
DB_PASSWORD=换成强随机值
DB_DATABASE=concise_server
MYSQL_ROOT_PASSWORD=换成强随机值

# JWT 密钥（必填，compose 里缺了会直接启动失败）
# 生成方式：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# 迁移开关：单实例 true；多副本部署时只留一个实例 true，其余 false
RUN_MIGRATIONS=true
